NODE_ENV=development

# Backend Server
PORT=3001

# MongoDB Configuration
# Local: mongodb://localhost:27017/555results
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/555results?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/555results

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend Configuration
# Dev: http://localhost:5173
# Prod: https://yourdomain.com
FRONTEND_URLS=http://localhost:5173,https://satta-bazaar.com,https://satta-bazaar.online,https://satta-bazaar.org

# Frontend API calls use relative /api paths. Vite proxies them in development,
# and Apache proxies them in production.
# Long random value used to pseudonymize anonymous visitor IDs in the database.
VISITOR_HASH_SECRET=replace-with-at-least-32-random-characters
# Express trust-proxy setting. The default trusts local/private reverse proxies.
# Set this only when your production proxy topology requires a different value.
# TRUST_PROXY=1
